# LIA API — environment
PORT=4000

# Comma-separated allowlist of frontend origins allowed to send credentials
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# REQUIRED in production (min 32 chars) — generate: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Where the JSON store lives (swap store module for Postgres in prod)
DATA_FILE=./data.json
